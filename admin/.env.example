# Copy to .env.local (gitignored) and fill in. The same backend the GymCrew app talks to — see
# ../backend/README.md. Example: https://gymcrew.site/api (no trailing slash).
VITE_API_BASE_URL=

# Optional — deep-link on the Analytics page (see src/pages/Analytics.tsx) to your Sentry
# organization/project dashboard. Defaults to the generic login page if left unset.
VITE_SENTRY_URL=
