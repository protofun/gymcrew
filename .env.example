EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# URL of the deployed backend (see backend/README.md). Leave empty during local dev without a
# deployed backend — the app falls back to local/demo data whenever this isn't reachable.
EXPO_PUBLIC_API_BASE_URL=

# Crash reporting (see src/config/sentry.ts). Leave empty to disable — Sentry becomes a no-op
# rather than erroring. Get this from Sentry -> your project -> Settings -> Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
