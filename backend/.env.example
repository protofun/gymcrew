# Copy this file to .env (same folder) and fill in real values. Never commit the real .env.

# From Hostinger hPanel -> Databases -> MySQL Databases (create a database + user there first).
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Clerk Dashboard -> Configure -> API Keys -> "Frontend API URL", then append /.well-known/jwks.json.
# Example: https://your-app-name.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Clerk Dashboard -> Configure -> API Keys -> "Secret keys" (starts with sk_). Used server-to-server
# only (never sent to any client) so the marketing site's Founding Athlete signup can create a
# matching real Clerk account and mint a one-time sign-in ticket for it — see
# routes/athlete-signup.php's createClerkUserForFoundingAthlete / createClerkSignInTicket. Leave
# empty to disable that specific feature; every other route keeps working without it.
CLERK_SECRET_KEY=

# The PWA's origin, e.g. https://app.yourdomain.com — or * while testing.
CORS_ORIGIN=*

# Only needed if this backend lives at a sub-path (e.g. https://yourdomain.com/api) rather than
# its own (sub)domain root. Leave empty if index.php IS the domain/subdomain root.
API_BASE_PATH=
