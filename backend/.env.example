# Copy this file to .env (same folder) and fill in real values. Never commit the real .env.

# From Hostinger hPanel -> Databases -> MySQL Databases (create a database + user there first).
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Clerk Dashboard -> Configure -> API Keys -> "Frontend API URL", then append /.well-known/jwks.json.
# Example: https://your-app-name.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Clerk Dashboard -> Configure -> API Keys -> "Secret keys" (starts with sk_). Used server-to-server
# only (never sent to any client) so the marketing site's Founding Athlete signup can create a
# matching real Clerk account and mint a one-time sign-in ticket for it — see
# routes/athlete-signup.php's createClerkUserForFoundingAthlete / createClerkSignInTicket. Leave
# empty to disable that specific feature; every other route keeps working without it.
CLERK_SECRET_KEY=

# AI meal-photo scan (see routes/nutrition-photo-scan.php). A free key from https://aistudio.google.com/apikey
# — server-side only, never sent to a client. Leave empty to switch the feature off (the app then
# shows "not available"). GEMINI_MODEL is optional; it defaults to gemini-3.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=

# The PWA's origin, e.g. https://app.yourdomain.com — or * while testing.
CORS_ORIGIN=*

# Only needed if this backend lives at a sub-path (e.g. https://yourdomain.com/api) rather than
# its own (sub)domain root. Leave empty if index.php IS the domain/subdomain root.
API_BASE_PATH=

# Admin panel (see routes/admin.php, admin-auth.php, and the admin/ React app). A long random
# string — generate one with e.g. `php -r "echo bin2hex(random_bytes(32));"` — used to sign admin
# login sessions. Changing it instantly logs every admin out (their tokens no longer verify).
ADMIN_JWT_SECRET=

# Only read by scripts/seed-admin.php — set both temporarily, run that script once (see its own
# doc comment for how), then feel free to remove these two lines. Not read anywhere else.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# "From" address for admin-panel broadcast emails (see routes/admin.php's sendBroadcastEmail) —
# sent via PHP's built-in mail(), which most Hostinger shared hosting plans support out of the box
# for the domain the account is on. Must be an address on your own domain (e.g.
# noreply@gymcrew.site) or many mail providers will spam-filter it.
ADMIN_EMAIL_FROM=
